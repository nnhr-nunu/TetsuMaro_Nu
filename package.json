{
  "name": "tetsumaro",
  "private": true,
  "type": "module",
  "dependencies": {
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@cloudflare/vitest-plugin": "^1.3.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "node-html-parser": "^9.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:local": "wrangler d1 migrations apply tetsumaro --local --config wrangler.jsonc",
    "e2e": "node -e \"require('node:fs').rmSync('.wrangler/state',{recursive:true,force:true})\" && playwright test",
    "nunu:fetch": "node scripts/nunu-fetch.mjs",
    "eval": "node scripts/eval.mjs",
    "deploy": "wrangler d1 migrations apply tetsumaro --remote --config wrangler.jsonc && wrangler deploy"
  }
}
